{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "pnpm install",
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "functions": {
    "api/flags.ts": {
      "includeFiles": "shared/**"
    }
  }
}
